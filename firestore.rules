rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these email addresses may write to admin-only collections.
    // To add more admins later, add their email here as well.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['hhackmapp@gmail.com'];
    }

    // True if the signed-in user's uid is in the vipUsers allowlist.
    // Used to gate Mystery Box spins to VIP customers only.
    function isVip() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/vipUsers/$(request.auth.uid));
    }

    // Categories & Products: Anyone can read, only admin can write
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Category Types (e.g. มาสไรเดอร์, อุลตราแมน...): Anyone can read, only admin can write
    match /categoryTypes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admin can update anything. A signed-in customer's checkout can also
      // update a product doc, but ONLY to decrement stockQty/inStock as part
      // of placing an order (see cart.html's order transaction) — they can
      // never touch price, name, image, etc., and can never raise the qty.
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stockQty', 'inStock', 'updatedAt']) &&
        request.resource.data.stockQty is number &&
        request.resource.data.stockQty <= resource.data.stockQty
      );
    }

    // Orders: Anyone can create, only admin or order owner can read/update
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Live Chat: Only logged-in users (customers or admin) can read/write.
    // Guests (not signed in) are blocked from chatting entirely.
    match /chats/{chatId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // User profile extras (e.g. custom uploaded avatar): only the owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // VIP Users: an admin-maintained allowlist (doc ID = customer's User
    // ID / Firebase Auth uid). Anyone can read — the storefront checks
    // "is the current user VIP?" client-side to gate the Mystery Box UI —
    // but only the admin can add or remove someone from the list.
    match /vipUsers/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App settings, e.g. settings/vipAuto = { enabled, limit, registeredCount }.
    // Only the admin panel edits `enabled`/`limit` directly (client write).
    // `registeredCount` is normally only touched by the autoAssignVip Cloud
    // Function, which uses the Admin SDK and bypasses these rules entirely
    // — this rule just stops a random signed-in user from tampering with it.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mystery Box Prizes: anyone can read (needed to compute odds and run
    // the spin on the storefront); only the admin can create/delete or
    // edit prize details (name, weight, minOrderAmount, etc).
    // Exception: a VIP customer's spin is also allowed to decrement
    // remainingQuantity by exactly 1 (and only that field) when they win a
    // limited-stock prize — same pattern as product stockQty above. This
    // is the real enforcement of "Mystery Box is VIP-only": even if
    // someone bypasses the client-side check, a non-VIP write here fails.
    match /luckyDrawPrizes/{prizeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isVip() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingQuantity']) &&
        request.resource.data.remainingQuantity is number &&
        resource.data.remainingQuantity is number &&
        request.resource.data.remainingQuantity == resource.data.remainingQuantity - 1 &&
        resource.data.remainingQuantity > 0
      );
    }
  }
}
